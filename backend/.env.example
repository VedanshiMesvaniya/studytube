# Required — get a free key at https://console.groq.com
GROQ_API_KEY=

# Optional — only needed if YouTube blocks your server's IP for captions
PROXY_USERNAME=
PROXY_PASSWORD=

# Optional — override default models
LLM_MODEL=llama-3.1-8b-instant
WHISPER_MODEL=whisper-large-v3-turbo

# Optional — comma-separated list of origins allowed to call this API.
# Defaults already cover the Vite dev server (http://localhost:5173).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
