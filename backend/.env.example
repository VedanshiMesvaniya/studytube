# Required — get a free key at https://build.nvidia.com (starts with "nvapi-")
NVIDIA_API_KEY=

# Optional — only needed if YouTube blocks your server's IP for captions
PROXY_USERNAME=
PROXY_PASSWORD=

# Optional — override default models (check build.nvidia.com/models for
# current, non-deprecated model IDs before changing these)
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_MODEL=nvidia/llama-3.3-nemotron-super-49b-v1
VISION_MODEL=nvidia/llama-3.1-nemotron-nano-vl-8b-v1
RIVA_SERVER=grpc.nvcf.nvidia.com:443
RIVA_ASR_FUNCTION_ID=1598d209-5e27-4d3c-8079-4751568b1081

# Optional — comma-separated list of origins allowed to call this API.
# Defaults already cover the Vite dev server (http://localhost:5173).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
