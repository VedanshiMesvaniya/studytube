# Only needed if you're running the frontend separately with `npm run dev`
# against a backend that ISN'T on http://localhost:8000 (that's already the
# dev-mode default). Leave this file un-copied for the normal
# `npm run build` + `uvicorn` single-server workflow — the app talks to
# itself via same-origin relative URLs in that case, and setting this would
# override that.
# VITE_API_BASE_URL=http://localhost:8000
